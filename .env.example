PORT=3000

# Comma-separated list of exact origins (no trailing slash, no markdown).
# Use * to allow any origin. localhost is always allowed.
CORS_ORIGIN=https://startling-lollipop-d83b3d.netlify.app,https://dance-luridness-broken.ngrok-free.dev
# Allow the app to be opened straight from disk (file:///.../index.html).
CORS_ALLOW_NULL_ORIGIN=true

# Either a single connection string...
# DATABASE_URL=mysql://user:pass@host:4000/qc_terminal
# ...or individual settings:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=qc_terminal
# TLS: true for hosted MySQL/TiDB, false for local MySQL. Unset = auto.
# DB_SSL=false

MYSQL_CONNECTION_LIMIT=10

# Login accounts: username:password:role[:Display label], comma-separated.
# Roles: admin, qa, qm. CHANGE THESE before going live.
QC_USERS=admin:admin123:admin,qa:qa123:qa,qm:qm123:qm
# Long random string used to sign login sessions.
AUTH_SECRET=replace-with-a-long-random-string
TOKEN_TTL_HOURS=12

# Resistance pass window
RESISTANCE_MIN=5.5
RESISTANCE_MAX=5.7
